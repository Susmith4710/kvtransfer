# Python build and cache files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Local virtual environments (the project venv lives in ~/.venvs/kvtransfer)
.venv/
venv/

# Experiment outputs: calibration statistics, mappers, reports, telemetry, logs.
# These are tens of gigabytes and are regenerated by `kvtransfer experiment`.
runs/
mappers/
stats/
artifacts/
*.log
*.watch

# Model weights and tensors never belong in the repository
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# Editor and OS clutter
.DS_Store
*.swp
.idea/
.vscode/
